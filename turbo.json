{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [".env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env.local"],
      "env": [
        "APP_ENV",
        "INTEGRATIONS_MODE",
        "NEXT_PUBLIC_SITE_URL",
        "SITE_INDEXABLE",
        "WEB_URL",
        "ADMIN_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "BETTER_AUTH_SECRET",
        "REVALIDATE_SECRET",
        "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "SHOP_INBOX_EMAIL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        "INDEXNOW_KEY",
        "SEED_ADMIN_EMAIL",
        "SEED_ADMIN_PASSWORD"
      ],
      "passThroughEnv": ["NETLIFY", "CONTEXT"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "APP_ENV",
        "INTEGRATIONS_MODE",
        "NEXT_PUBLIC_SITE_URL",
        "SITE_INDEXABLE",
        "WEB_URL",
        "ADMIN_URL",
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "BETTER_AUTH_SECRET",
        "REVALIDATE_SECRET",
        "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME",
        "CLOUDINARY_API_KEY",
        "CLOUDINARY_API_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "SHOP_INBOX_EMAIL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        "INDEXNOW_KEY",
        "SEED_ADMIN_EMAIL",
        "SEED_ADMIN_PASSWORD"
      ]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    }
  }
}
