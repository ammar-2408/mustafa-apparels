{
  "name": "mustafa-apparels",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "eslint e2e playwright.config.ts scripts .claude/hooks && turbo run lint",
    "typecheck": "tsc -p e2e && tsc -p scripts && turbo run typecheck",
    "test": "vitest run --project workspace && turbo run test",
    "test:e2e": "playwright test",
    "test:seo": "playwright test e2e/seo",
    "test:a11y": "playwright test e2e/a11y",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "env:check": "node packages/config/check-env.mjs web && node packages/config/check-env.mjs admin",
    "db:generate": "pnpm --filter @mustafa/db generate",
    "db:migrate": "pnpm --filter @mustafa/db migrate",
    "db:seed": "pnpm --filter @mustafa/db seed",
    "prepare": "husky || exit 0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@mustafa/config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "^24",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
