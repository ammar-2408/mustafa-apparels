# Copy to .env.local and fill in. Never commit real values.
# Each app validates these at startup (packages/config/env.ts) and refuses to run if any are missing.

# ---------- Site ----------
# Public storefront URL. Drives canonical URLs, sitemap, Open Graph and llms.txt.
# Local: http://localhost:3000 · Production: https://<shop-name>.netlify.app (later your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Storefront URL as seen from the admin app (for cache revalidation calls)
WEB_URL=http://localhost:3000
# Admin URL (used for auth trusted origins)
ADMIN_URL=http://localhost:3001
# "production" only on the live site; anything else adds noindex everywhere
APP_ENV=development
# "live" uses real Cloudinary/Resend/Upstash; "mock" uses in-memory fakes (tests, offline dev)
INTEGRATIONS_MODE=live

# ---------- Database (Neon PostgreSQL) ----------
# Pooled connection (apps)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection (migrations only)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---------- Auth (Better Auth) ----------
# openssl rand -base64 32  (different value per environment)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ---------- Cross-app cache revalidation ----------
# openssl rand -base64 32  (same value in web and admin of the same environment)
REVALIDATE_SECRET=

# ---------- Images (Cloudinary) ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM="<SHOP_NAME> <onboarding@resend.dev>"
# Where new inquiry notifications go
SHOP_INBOX_EMAIL=

# ---------- Rate limiting (Upstash Redis) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Seed (local / CI only — remove from hosting after first seed) ----------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
