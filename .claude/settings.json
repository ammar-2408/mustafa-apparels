{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install *)",
      "Bash(pnpm add *)",
      "Bash(pnpm dev *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test *)",
      "Bash(pnpm verify *)",
      "Bash(pnpm build *)",
      "Bash(pnpm db:generate *)",
      "Bash(pnpm db:migrate *)",
      "Bash(pnpm db:seed *)",
      "Bash(pnpm exec playwright *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm turbo *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin develop)",
      "Bash(git switch *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(npx -y skills add *)",
      "Bash(bash scripts/install-skills.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Read(./.env.preview)",
      "Read(./.env.staging)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Read(./**/.env.preview)",
      "Read(./**/.env.staging)",
      "Bash(git diff --no-index*)",
      "Bash(git diff * --no-index*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git push * main*)",
      "Bash(git push *:main*)",
      "Bash(git switch main*)",
      "Bash(git switch * main*)",
      "Bash(git checkout main*)",
      "Bash(git checkout * main*)",
      "Bash(gh pr merge *)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(pnpm drizzle-kit push *)",
      "Bash(npx drizzle-kit push *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-files.mjs"],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-gate.mjs"],
            "timeout": 300
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/format-file.mjs"],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
