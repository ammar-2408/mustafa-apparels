# Run once in the repo root: cp .env.example .env.local
# Works as it is in mock mode. Never commit real values.
# `pnpm dev`, `build` and `start` check these first (packages/config/env.ts) and stop if something's wrong.
# Which site needs which variable: docs/setup.md §6.

# ---------- Environment ----------
# development | test | preview | production
APP_ENV=development
# "live" uses real services and requires all their values. "mock" uses in-memory fakes and makes
# the database, auth and service values below optional. Switch to live once the accounts exist.
INTEGRATIONS_MODE=mock

# ---------- Site ----------
# Drives canonical URLs, sitemap, Open Graph and llms.txt. Production: https://mustafaapparels.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Stays false until launch, and can only be true on production
SITE_INDEXABLE=false
# Storefront URL as seen from the admin app, for cache revalidation. Production: https://mustafaapparels.com
WEB_URL=http://localhost:3000
# Production: https://admin.mustafaapparels.com
ADMIN_URL=http://localhost:3001

# ---------- Database (Neon PostgreSQL) ----------
# Pooled connection (apps)
DATABASE_URL=
# Direct connection (migrations only)
DATABASE_URL_UNPOOLED=

# ---------- Auth (Better Auth) ----------
# openssl rand -base64 32  (different value per environment)
BETTER_AUTH_SECRET=
# Differs per app. For the admin locally, put BETTER_AUTH_URL=http://localhost:3001 in apps/admin/.env.local
BETTER_AUTH_URL=http://localhost:3000

# ---------- Cross-app cache revalidation ----------
# openssl rand -base64 32  (same value in web and admin of the same environment)
REVALIDATE_SECRET=

# ---------- Images and video (Cloudinary) ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
EMAIL_FROM="Mustafa Apparels <no-reply@updates.mustafaapparels.com>"
# Where new inquiry notifications go
SHOP_INBOX_EMAIL=

# ---------- Rate limiting (Upstash Redis) ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Analytics and indexing (production sites only; leave blank here) ----------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
INDEXNOW_KEY=

# ---------- Seed (local only, never in hosting env) ----------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
